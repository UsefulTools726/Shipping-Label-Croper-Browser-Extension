{
  "manifest_version": 3,
  "name": "Shipping Label Cropper",
  "version": "1.3.0",
  "description": "Crop shipping label PDFs to the label area in one click. Learn custom crops, adjust margins, and keep barcode quality for printing.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Click to crop label · Right-click for more",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "libs/*",
        "process.html",
        "process-page.js",
        "editor.html",
        "editor.js",
        "label-core.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "shipping-label-cropper@n9mur",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
